generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  clerkId   String     @unique
  email     String     @unique
  createdAt DateTime   @default(now())
  analyses  Analysis[]
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fileName        String
  score           Int
  experienceYears Int
  topSkills       String[]
  strengths       String[]
  gaps            String[]
  summary         String
  createdAt       DateTime @default(now())
}